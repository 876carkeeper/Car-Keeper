{
  "name": "CarKeeper — Vehicle Management",
  "short_name": "CarKeeper",
  "description": "Track every vehicle, service, repair and expense in one place. Maintenance predictions, cost reports and an AI car assistant.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#06070A",
  "theme_color": "#06070A",
  "categories": ["productivity", "utilities", "finance"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My Garage", "url": "./index.html#garage", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Expenses", "url": "./index.html#exp", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ]
}
